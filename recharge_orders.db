DELETE FROM operator_plans
WHERE plan_text LIKE '%<div%'
   OR plan_text LIKE '%</%'
   OR plan_text LIKE '%<span%'
   OR plan_text LIKE '%<input%'
   OR plan_text LIKE '%<textarea%'
   OR plan_text LIKE '%<button%'
   OR plan_text LIKE '%function %'
   OR plan_text LIKE '%row.style%'
   OR plan_text LIKE '%setTimeout%'
   OR plan_text LIKE '%location.reload%'
   OR plan_text LIKE '%alert(%'
   OR plan_text LIKE '%const %'
   OR plan_text LIKE '%} else {%'
   OR plan_text LIKE '%});%'
   OR plan_text LIKE '%span_%';
